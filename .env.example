# OpenID Connect sign-in settings
# Copy to .env.local for `vp dev` / `vp preview`. Never commit secrets.

# Public app origin — must match the browser origin AND a registered redirect URI.
# Local:  http://localhost:4177
# Prod:   https://effectlatam.com
APP_URL=http://localhost:4177

# Identity provider base URL
# AUTH_URL=https://auth.proyectoviviana.org

# Client id registered with the identity provider
# EFFECT_LATAM_CLIENT_ID=effect-latam

# Confidential client secret — required for token exchange after authorize.
# Get it from your identity provider; never commit it.
EFFECT_LATAM_CLIENT_SECRET=

# Production: provision as a Wrangler secret (comma-separated). Do not commit it.
# Local only: set in `.dev.vars` if staff-role testing is needed.
# EFFECT_LATAM_ADMIN_EMAILS=admin@example.com

# Explicit local-only dev login. It never defaults on.
# EFFECT_LATAM_DEV_AUTH=0
