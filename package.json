{
  "name": "effect-latam",
  "version": "0.4.0",
  "private": true,
  "description": "Effect Latam: a Spanish-first site for learning Effect. https://effectlatam.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proyecto-viviana/effect-latam.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && tsc --noEmit",
    "preview": "vp preview",
    "deploy": "vp run build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:dry-run": "vp run build && wrangler deploy --dry-run --config dist/server/wrangler.json",
    "test": "vp test run --config vitest.config.ts",
    "test:watch": "vp test --config vitest.config.ts",
    "test:e2e": "vp run build && playwright test",
    "test:e2e:run": "playwright test",
    "test:security:runtime": "node src/security/abuse-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "check": "vp fmt . --check && vp lint --deny-warnings && tsc --noEmit",
    "lint": "vp lint --deny-warnings",
    "lint:fix": "vp lint --fix --deny-warnings",
    "fmt": "vp fmt . --write",
    "fmt:check": "vp fmt . --check",
    "db:migrate:local": "wrangler d1 migrations apply effect-latam-db --local --config wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply effect-latam-db --remote --config wrangler.jsonc",
    "cf-typegen": "wrangler types --config wrangler.jsonc",
    "prepare": "VITE_GIT_HOOKS=0 vp config",
    "dev:local": "vp run db:migrate:local && vp dev"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@solidjs/web": "2.0.0-rc.4",
    "@tanstack/solid-router": "2.0.0-rc.4",
    "@tanstack/solid-start": "2.0.0-rc.4",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-rc.112",
    "jose": "^6.2.10",
    "solid-js": "2.0.0-rc.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@playwright/test": "^1.61.1",
    "@solidjs/vite-plugin": "3.0.0-next.36",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.12.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24",
    "wrangler": "4.127.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0"
}
